# Copy to /etc/hs6tools/recovery.env with mode 0600. Do not commit real values.
RECOVERY_CONFIG_VERSION=1
RECOVERY_ENVIRONMENT=production
BACKUP_PG_SERVICE=hs6tools-backup
PGSERVICEFILE=/etc/hs6tools/pg_service.conf
PGPASSFILE=/etc/hs6tools/.pgpass
BACKUP_ROOT=/var/backups/hs6tools/application
PITR_BASE_BACKUP_DIR=/var/backups/hs6tools/pitr-base
WAL_ARCHIVE_DIR=/var/backups/hs6tools/wal
UPLOADS_DIR=/var/www/hs6tools/current/public/uploads
RUNTIME_CONFIG_FILE=/var/www/hs6tools/shared/.env.production
BACKUP_PASSPHRASE_FILE=/etc/hs6tools/backup-passphrase
RELEASE_ID=replace-with-deployed-commit
RETENTION_DAYS=35
PITR_RETENTION_DAYS=35
RECOVERY_AUDIT_LOG=/var/log/hs6tools/recovery-audit.log
# Optional executable receives only BACKUP_EVENT and BACKUP_KIND.
BACKUP_ALERT_COMMAND=/usr/local/sbin/hs6tools-backup-alert
