# Staging/recovery only. Keep this file mode 0600 and use isolated credentials.
RECOVERY_ENVIRONMENT=staging
BACKUP_PASSPHRASE_FILE=/etc/hs6tools/backup-passphrase
RECOVERY_OPERATOR=replace-with-named-operator
RECOVERY_ACCESS_TICKET=replace-with-approved-ticket
RECOVERY_DATABASE_NAME=hs6tools_restore_yyyymmdd
RECOVERY_ADMIN_DATABASE_URL=postgresql://recovery-admin@localhost:5432/postgres
RECOVERY_CONTROL_DATABASE_URL=postgresql://recovery-admin@localhost:5432/hs6tools_recovery_control
RECOVERY_INSTANCE_ID=replace-with-isolated-cluster-id
TARGET_DATABASE_URL=postgresql://recovery-owner@localhost:5432/hs6tools_restore_yyyymmdd
RECOVERY_AUDIT_LOG=/var/log/hs6tools/recovery-audit.log
RECOVERY_EVIDENCE_DIR=/var/lib/hs6tools-recovery/evidence/yyyymmdd
RECOVERY_UPLOADS_DIR=/var/lib/hs6tools-recovery/uploads/yyyymmdd
RECOVERY_SMOKE_URL=http://127.0.0.1:3001/api/recovery/smoke
RECOVERY_SMOKE_TOKEN_FILE=/etc/hs6tools/recovery-smoke-token
RECOVERY_APP_START_COMMAND=/usr/local/sbin/start-hs6tools-recovery-smoke
RECOVERY_INCIDENT_EPOCH=replace-with-incident-declaration-unix-epoch
EXTERNAL_EFFECTS_DISABLED=true

# Keep all real provider credentials absent from the restore process and runtime.
SMSIR_API_KEY=
KAVENEGAR_API_KEY=
KAVENEGAR_API_TOKEN=
ZARINPAL_MERCHANT_ID=
SMTP_PASS=
